<?xml version="1.0" encoding="utf-8"?>
<!-- Self-contained release build: no .NET install needed on the target PC.
     Usage: dotnet publish src/Pitstop.App -p:PublishProfile=win-x64 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Precompiled code starts faster and needs less JIT memory. Single-file compression is left off on purpose:
         it unpacks assemblies into private memory at startup, and the installer compresses anyway. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <!-- English-only app: skip the framework's translated resource files. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>

  <!-- The Windows Desktop runtime pack ships WPF alongside WinForms. Pitstop is WinForms-only (BUG-008),
       so WPF's assemblies and native renderer are left out of the package (BUG-010). -->
  <Target Name="ExcludeWpfFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_WpfFile Include="@(ResolvedFileToPublish)"
                Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '^(PresentationFramework.*|PresentationCore|PresentationUI|PresentationNative_cor3|ReachFramework|System\.Windows\.Presentation|System\.Windows\.Controls\.Ribbon|System\.Windows\.Input\.Manipulations|System\.Xaml|System\.Printing|UIAutomation.*|WindowsFormsIntegration|DirectWriteForwarder|wpfgfx_cor3|PenImc_cor3|D3DCompiler_47_cor3)$'))" />
      <ResolvedFileToPublish Remove="@(_WpfFile)" />
      <!-- Debug symbols of the referenced projects aren't covered by DebugType=none above. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
